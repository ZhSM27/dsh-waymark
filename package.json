{
  "name": "dsh-waymark",
  "version": "0.2.0-alpha.1",
  "type": "module",
  "description": "Local, evidence-grounded agent workflow diagnostics for DeepSeek Harness",
  "engines": { "node": ">=24.11.0", "dsh": "0.2.1-rc.5" },
  "main": "./lib/plugin.js",
  "exports": { ".": { "types": "./lib/plugin.d.ts", "default": "./lib/plugin.js" }, "./core": { "types": "./lib/core/index.d.ts", "default": "./lib/core/index.js" } },
  "files": ["lib", "docs", "cordis.patch.yml", "README.md", "LICENSE"],
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/ZhSM27/dsh-waymark.git" },
  "homepage": "https://github.com/ZhSM27/dsh-waymark#readme",
  "bugs": { "url": "https://github.com/ZhSM27/dsh-waymark/issues" },
  "publishConfig": { "access": "public", "tag": "alpha", "registry": "https://registry.npmjs.org/" },
  "keywords": ["dsh-plugin", "deepseek-harness", "agent", "workflow", "retrospective", "local-first", "diagnostics"],
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.core.json",
    "build": "node scripts/build.mjs",
    "check:build": "node test/bundle-smoke.mjs",
    "check:package": "node scripts/check-package.mjs",
    "demo": "node scripts/demo-core.mjs",
    "test": "node --test test/*.test.mjs",
    "probe": "node scripts/probe-session.mjs"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "tsdown": "0.22.2",
    "typescript": "6.0.3"
  }
}
